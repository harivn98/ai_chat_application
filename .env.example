# Copy to .env to override defaults used by docker-compose.yml

# GPU or CPU is chosen automatically by start.ps1 / start.sh, which write COMPOSE_FILE here.
MONGO_USER=admin
MONGO_PASSWORD=admin

LLM_MODEL=qwen3:8b
LLM_NUM_CTX=8192
# Qwen3 reasoning mode. false = direct answers (faster)
LLM_THINK=false
# Keep the model in memory between requests; timeouts in seconds (CPU-only machines are slow)
LLM_KEEP_ALIVE=30m
LLM_TIMEOUT=600
LLM_LOAD_TIMEOUT=1800

# Contextual embedding (Contextual Retrieval): true or false.
#   true  = CONTEXT_MODEL writes a short context for every chunk; it is added to the text that is
#           embedded and BM25-indexed (slower uploads, better retrieval)
#   false = chunks are embedded/indexed as-is (original pipeline)
# Only affects documents uploaded after the change. CONTEXT_NUM_CTX = tokens of the document the model reads.
CONTEXTUAL_EMBEDDING=true
CONTEXT_MODEL=qwen3:4b
CONTEXT_NUM_CTX=16384

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
BM25_CANDIDATES=10
# Minimum cosine similarity for a chunk from the embedding search
VECTOR_MIN_SCORE=0.85

# QASPER evaluation judge (pull it first if it differs from LLM_MODEL)
JUDGE_MODEL=qwen3:8b

MAX_UPLOAD_MB=25
