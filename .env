# Settings used by docker-compose.yml. Apply changes with .\start.ps1 (or ./start.sh).

# GPU or CPU is chosen automatically by start.ps1 / start.sh, which write COMPOSE_FILE at the end of this file.
MONGO_USER=admin
MONGO_PASSWORD=admin

LLM_MODEL=qwen3:8b
LLM_NUM_CTX=8192
# Qwen3 reasoning mode. false = direct answers (faster)
LLM_THINK=false
# Answer randomness: 0 = deterministic (same question + chunks -> same answer; best for evaluations)
LLM_TEMPERATURE=0
# Keep the model in memory between requests; timeouts in seconds (CPU-only machines are slow)
LLM_KEEP_ALIVE=30m
LLM_TIMEOUT=600
LLM_LOAD_TIMEOUT=1800

# Contextual embedding (Contextual Retrieval): true or false.
#   true  = CONTEXT_MODEL writes a short context for every chunk; it is added to the text that is
#           embedded and BM25-indexed (slower uploads, better retrieval)
#   false = chunks are embedded/indexed as-is (original pipeline)
# Only affects documents uploaded after the change. CONTEXT_NUM_CTX = tokens of the document the model reads.
CONTEXTUAL_EMBEDDING=true
# Use a non-thinking model: plain qwen3:4b is the thinking-only 2507 release and writes its reasoning instead of a context.
# qwen3:1.7b was tested: 39% faster, but retrieval recall@5 fell from 83.3 to 67.5 (run ctx_qwen3_1_7b)
CONTEXT_MODEL=qwen3:4b-instruct
CONTEXT_NUM_CTX=16384

# Pre-judge: true or false. Before answering, the answering model (LLM_MODEL) checks whether the top-k passages
# are relevant to the question; if not, answer generation is skipped and the reply is "not enough content in the
# document". It is the model already on the GPU, so no model is swapped between the check and the answer.
# false = every question goes straight to the answering model
PREJUDGE_ENABLED=false

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Best measured setup so far (run ce_reranker): BM25 top 10 + vector top 20 with cosine similarity >= 0.85,
# fused, and the reranker chooses the best TOP_K from the top 20
BM25_CANDIDATES=10
# Minimum cosine similarity for a chunk from the embedding search
VECTOR_MIN_SCORE=0.85
# Max chunks the vector search returns before the score cutoff; RRF constant; chat turns sent as history
VECTOR_CANDIDATES=20
RRF_K=60
HISTORY_TURNS=6

# Reranker: true or false. A cross-encoder re-scores the top RERANK_CANDIDATES fused BM25 + vector chunks
# against the question and keeps the best TOP_K.
# false = the top TOP_K chunks from RRF fusion go straight to the LLM. The models are baked into the backend image.
RERANKER_ENABLED=true
# Which reranker runs (both are baked into the backend image):
#   BAAI/bge-reranker-base               more accurate, ~6-9 s for 30 chunks on 4 CPU cores
#   cross-encoder/ms-marco-MiniLM-L6-v2  faster, ~1 s for 30 chunks, weaker on large candidate pools
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATES=20

# QASPER evaluation judge (pull it first if it differs from LLM_MODEL)
JUDGE_MODEL=qwen3:8b

MAX_UPLOAD_MB=25

# Cloud mode (picked per upload in the UI; private mode above stays the default). All cloud models run through
# OpenRouter, so the document text and the questions leave this machine. It needs OPENROUTER_API_KEY. Do NOT put the
# key in this file (it is committed to git): set it as an environment variable on your machine (see README).
# Model IDs are OpenRouter's (https://openrouter.ai/models).
CLOUD_EMBED_MODEL=google/gemini-embedding-2
# Vector size of the cloud embeddings (up to 3072). Changing it needs the cloud vector index to be rebuilt.
CLOUD_EMBED_DIM=768
# Minimum cosine similarity for cloud embedding hits. 0 = no cutoff; not tuned yet (bge's 0.85 doesn't carry over).
CLOUD_VECTOR_MIN_SCORE=0
CLOUD_CONTEXT_MODEL=google/gemini-3.5-flash-lite
CLOUD_LLM_MODEL=deepseek/deepseek-v4.1-flash

COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
